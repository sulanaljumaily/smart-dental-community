{
  "name": "smart-dental-community",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate || echo 'Skipping Prisma generation - will run in build step'",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "socket": "node socket-server.js",
    "socket:dev": "NODE_ENV=development node socket-server.js",
    "socket:prod": "NODE_ENV=production node socket-server.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next node_modules"
  },
