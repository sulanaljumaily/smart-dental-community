// Prisma Schema for Smart Dental Community Platform
// قاعدة بيانات منصة المجتمع الطبي للأسنان

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================================
// ENUMS - التعدادات
// =======================================

enum UserRole {
  DENTIST // طبيب أسنان
  VENDOR // مورد
  LAB // معمل أسنان
  ADMIN // إدارة المنصة
  STAFF // طاقم العيادة
  PATIENT // مريض (للاستخدام المستقبلي)
}

enum ClinicStaffRole {
  OWNER // مالك
  DENTIST // طبيب
  ASSISTANT // مساعد
  RECEPTIONIST // استقبال
  NURSE // ممرض
}

enum Permission {
  // صلاحيات المرضى
  VIEW_PATIENTS
  ADD_PATIENTS
  EDIT_PATIENTS
  DELETE_PATIENTS

  // صلاحيات المواعيد
  VIEW_APPOINTMENTS
  ADD_APPOINTMENTS
  EDIT_APPOINTMENTS
  DELETE_APPOINTMENTS

  // صلاحيات الخطط العلاجية
  VIEW_TREATMENTS
  ADD_TREATMENTS
  EDIT_TREATMENTS
  DELETE_TREATMENTS

  // صلاحيات المالية
  VIEW_FINANCES
  ADD_FINANCES
  EDIT_FINANCES
  DELETE_FINANCES

  // صلاحيات المخزون
  VIEW_INVENTORY
  ADD_INVENTORY
  EDIT_INVENTORY
  DELETE_INVENTORY

  // صلاحيات المختبر
  VIEW_LAB_ORDERS
  ADD_LAB_ORDERS
  EDIT_LAB_ORDERS
  DELETE_LAB_ORDERS

  // صلاحيات الطاقم
  VIEW_STAFF
  ADD_STAFF
  EDIT_STAFF
  DELETE_STAFF

  // صلاحيات الإعدادات
  VIEW_SETTINGS
  EDIT_SETTINGS

  // صلاحيات التقارير
  VIEW_REPORTS
  EXPORT_REPORTS
}

enum AppointmentStatus {
  PENDING // قيد الانتظار
  CONFIRMED // مؤكد
  CANCELLED // ملغى
  COMPLETED // مكتمل
  NO_SHOW // لم يحضر
}

enum TreatmentType {
  FILLING // حشوة
  ROOT_CANAL // علاج عصب
  EXTRACTION // خلع
  CROWN // تاج
  BRIDGE // جسر
  IMPLANT // زراعة
  ORTHODONTICS // تقويم
  CLEANING // تنظيف
  WHITENING // تبييض
  DENTURE // طقم أسنان
}

enum ToothCondition {
  HEALTHY // سليم
  CAVITY // تسوس
  FILLED // محشو
  MISSING // مفقود
  CROWNED // مُتوج
  ROOT_CANAL_TREATED // معالج عصب
  EXTRACTED // مخلوع
  IMPLANT // مزروع
  DAMAGED // تالف
}

enum SessionStatus {
  SCHEDULED // مجدول
  IN_PROGRESS // جاري
  COMPLETED // مكتمل
  CANCELLED // ملغى
}

enum LabOrderStatus {
  PENDING // قيد الانتظار
  ACCEPTED // مقبول
  IN_PROGRESS // جاري التحضير
  READY // جاهز
  IN_TRANSIT // في الطريق
  DELIVERED // تم التسليم
  RETURNED // معاد
}

enum PaymentStatus {
  PAID // مدفوع
  UNPAID // غير مدفوع
  PARTIAL // جزئي
}

enum TaskType {
  GENERAL // عام
  INVENTORY // مخزون
  APPOINTMENT // موعد
  FOLLOW_UP // متابعة
  URGENT // عاجل
}

enum TaskStatus {
  PENDING // قيد الانتظار
  IN_PROGRESS // جاري
  COMPLETED // مكتمل
  POSTPONED // مؤجل
}

enum SubscriptionTier {
  FREE // مجاني
  BASIC // أساسي
  PROFESSIONAL // احترافي
  ENTERPRISE // مؤسسي
}

enum MessageType {
  STAFF // رسائل طاقم العيادة
  VENDOR // رسائل مع الموردين
  LAB // رسائل مع المختبر/معمل الأسنان
  ADMIN // رسائل مع إدارة المنصة
  COMMUNITY // رسائل مع الأصدقاء في المجتمع الطبي
  SYSTEM // رسائل النظام
}

enum NotificationType {
  APPOINTMENT // موعد
  INVENTORY // مخزون
  ORDER // طلبية
  LAB_DELIVERY // توصيل مختبر
  TASK // مهمة
  MESSAGE // رسالة
  SYSTEM // نظام
}

enum JobType {
  FULL_TIME // دوام كامل
  PART_TIME // دوام جزئي
  CONTRACT // عقد
}

enum JobStatus {
  ACTIVE // نشط
  CLOSED // مغلق
  FILLED // تم شغله
}

// =======================================
// CORE MODELS - النماذج الأساسية
// =======================================

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  phone      String?  @unique
  password   String
  name       String
  avatar     String?
  role       UserRole
  isVerified Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  dentistProfile DentistProfile?
  vendorProfile  VendorProfile?
  labProfile     LabProfile?

  // المحادثات
  conversations1 Conversation[] @relation("ConversationParticipant1")
  conversations2 Conversation[] @relation("ConversationParticipant2")

  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  notifications    Notification[]
  posts            Post[]
  comments         Comment[]
  jobs             Job[]

  @@index([email])
  @@index([role])
}

model DentistProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialization    String?
  licenseNumber     String? @unique
  yearsOfExperience Int?
  bio               String? @db.Text
  address           String?
  city              String?

  subscriptionTier   SubscriptionTier @default(FREE)
  subscriptionEndsAt DateTime?

  aiCreditsUsed Int @default(0)
  maxAiCredits  Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  clinics       Clinic[]
  staffRoles    ClinicStaff[]
  createdTasks  Task[]        @relation("TaskCreator")
  assignedTasks Task[]        @relation("TaskAssignee")

  @@index([userId])
}

model VendorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName   String
  licenseNumber String? @unique
  address       String?
  city          String?
  description   String? @db.Text
  logo          String?

  commissionRate Float @default(0.05) // نسبة المنصة

  isApproved  Boolean @default(false)
  isSuspended Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products Product[]
  orders   Order[]

  @@index([userId])
}

model LabProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  labName         String
  licenseNumber   String?  @unique
  address         String?
  city            String?
  description     String?  @db.Text
  specializations String[] // أنواع الخدمات

  isApproved  Boolean @default(false)
  isSuspended Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deliveryStaff LabDeliveryStaff[]
  orders        LabOrder[]
  savedByClinic SavedLab[]

  @@index([userId])
}

// =======================================
// CLINIC MANAGEMENT - إدارة العيادات
// =======================================

model Clinic {
  id      String  @id @default(cuid())
  name    String
  address String?
  city    String?
  phone   String?
  email   String?

  latitude  Float?
  longitude Float?
  showOnMap Boolean @default(false)

  workingHours Json? // {saturday: {open: "09:00", close: "17:00"}, ...}
  bookingLink  String? @unique

  ownerId String
  owner   DentistProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  staff        ClinicStaff[]
  patients     Patient[]
  appointments Appointment[]
  treatments   Treatment[]
  inventory    InventoryItem[]
  assets       Asset[]
  finances     Finance[]
  labOrders    LabOrder[]
  tasks        Task[]
  savedLabs    SavedLab[]

  @@index([ownerId])
  @@index([bookingLink])
}

model ClinicStaff {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  dentistId String?
  dentist   DentistProfile? @relation(fields: [dentistId], references: [id], onDelete: Cascade)

  // معلومات الحساب للطاقم
  userId   String? // ربط مع حساب User للمالك أو الطبيب
  name     String // اسم عضو الطاقم
  email    String? // البريد الإلكتروني
  phone    String? // رقم الهاتف
  password String? // كلمة المرور الخاصة (hashed)

  role        ClinicStaffRole
  specialty   String? // التخصص
  permissions Permission[] // الصلاحيات المخصصة

  salary   Float?
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  isActive  Boolean   @default(true)
  lastLogin DateTime? // آخر تسجيل دخول

  // Relations
  appointments   Appointment[]
  treatmentPlans TreatmentPlan[]

  @@index([clinicId])
  @@index([dentistId])
  @@index([email])
}

// =======================================
// PATIENT MANAGEMENT - إدارة المرضى
// =======================================

model Patient {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name        String
  phone       String
  email       String?
  dateOfBirth DateTime?
  gender      String?
  address     String?

  medicalHistory Json? // التاريخ الطبي
  allergies      String[] // الحساسيات

  totalVisits Int       @default(0)
  lastVisit   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  appointments   Appointment[]
  treatmentPlans TreatmentPlan[]
  teeth          Tooth[]
  documents      PatientDocument[]
  finances       PatientFinance[]

  @@index([clinicId])
  @@index([phone])
}

model Tooth {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  toothNumber       Int // 1-32 (FDI system)
  condition         ToothCondition
  previousTreatment String?
  notes             String?        @db.Text

  updatedAt DateTime @updatedAt

  // Relations
  treatmentPlans TreatmentPlan[]

  @@unique([patientId, toothNumber])
  @@index([patientId])
}

model PatientDocument {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  title       String
  type        String // X-Ray, Report, Image, etc.
  fileUrl     String
  description String? @db.Text

  uploadedAt DateTime @default(now())

  @@index([patientId])
}

// =======================================
// APPOINTMENTS - الحجوزات
// =======================================

model Appointment {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  staffId String?
  staff   ClinicStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  date     DateTime
  duration Int               @default(30) // minutes
  type     String? // نوع الموعد
  status   AppointmentStatus @default(PENDING)
  notes    String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([patientId])
  @@index([date])
}

// =======================================
// TREATMENT PLANS - الخطط العلاجية
// =======================================

model Treatment {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name        String
  type        TreatmentType
  description String?       @db.Text
  price       Float

  defaultSessions Int   @default(1)
  sessionDetails  Json? // تفاصيل الجلسات الافتراضية

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  treatmentPlans TreatmentPlan[]

  @@index([clinicId])
}

model TreatmentPlan {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  toothId String?
  tooth   Tooth?  @relation(fields: [toothId], references: [id], onDelete: SetNull)

  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  dentistId String?
  dentist   ClinicStaff? @relation(fields: [dentistId], references: [id], onDelete: SetNull)

  totalCost  Float
  amountPaid Float @default(0)

  progress Int @default(0) // 0-100%

  notes   String? @db.Text
  details Json? // تفاصيل خاصة بالعلاج

  // Lab Order Requirements
  needsLabOrder Boolean @default(false) // هل يحتاج طلب مختبر
  labOrderRequested Boolean @default(false) // تم طلب المختبر

  status String @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions  TreatmentSession[]
  labOrders LabOrder[]

  @@index([patientId])
  @@index([treatmentId])
}

model TreatmentSession {
  id     String        @id @default(cuid())
  planId String
  plan   TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  sessionNumber Int
  scheduledDate DateTime?
  completedDate DateTime?
  status        SessionStatus @default(SCHEDULED)

  notes   String? @db.Text
  details Json? // تفاصيل كل جلسة (طول الجذور، نوع الحشوة، إلخ)

  // حقول تفصيلية لعلاج العصب
  rootCanals       Int? // عدد قنوات العصب
  canalLength      String? // طول القناة/العصب (مثال: 21mm)
  filesUsed        String[] // الملفات المستخدمة (مثال: ["#15", "#20", "#25"])
  rootFillingType  String? // نوع حشو العصب (Gutta-percha, MTA, etc)
  rootFillingLength String? // طول حشو العصب
  finalFillingType String? // نوع الحشوة النهائية (عادية/معقدة/تركيبة)

  // حقول تفصيلية للتركيبات
  crownType        String? // نوع التاج (خزفي، معدني، زيركون)
  crownColor       String? // لون التاج/التركيبة
  bridgeSpan       String? // نطاق الجسر (من سن إلى سن)
  postAndCore      Boolean @default(false) // هل يحتاج post and core
  needsCrownCoverage Boolean @default(false) // تغطية بالتاج

  // حقول تفصيلية للتقويم
  bracketType      String? // نوع التقويم (معدني، شفاف، خزفي)
  archWireSize     String? // حجم السلك
  elasticType      String? // نوع المطاط
  tighteningAmount String? // مقدار الشد

  // حقول تفصيلية للزراعة
  implantBrand     String? // ماركة الزرعة
  implantDiameter  String? // قطر الزرعة
  implantLength    String? // طول الزرعة
  healingPeriod    String? // فترة الالتئام
  abutmentType     String? // نوع الدعامة

  // حقول عامة
  measurements     Json? // قياسات أخرى
  materials        String[] // المواد المستخدمة
  stage            String? // المرحلة الحالية

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
}

// =======================================
// LAB MANAGEMENT - إدارة المختبرات
// =======================================

model LabOrder {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  labId String
  lab   LabProfile @relation(fields: [labId], references: [id], onDelete: Cascade)

  planId String?
  plan   TreatmentPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  orderType      String // نوع الطلب
  description    String? @db.Text
  specifications Json?

  status        LabOrderStatus @default(PENDING)
  paymentStatus PaymentStatus  @default(UNPAID)

  amount Float
  platformFee Float @default(0) // نسبة المنصة

  // Lab details
  labIsInPlatform Boolean @default(false) // هل المختبر موجود في المنصة
  customLabName   String? // اسم المختبر المخصص (للمختبرات غير المسجلة)
  customLabPhone  String? // رقم هاتف المختبر المخصص

  dueDate       DateTime
  deliveredDate DateTime?

  deliveryStaffId String?
  deliveryStaff   LabDeliveryStaff? @relation(fields: [deliveryStaffId], references: [id], onDelete: SetNull)

  // Tracking & Tasks
  taskId String? // ربط بالمهمة المرتبطة
  notificationSent Boolean @default(false) // تم إرسال الإشعار

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([labId])
  @@index([status])
}

model LabDeliveryStaff {
  id    String     @id @default(cuid())
  labId String
  lab   LabProfile @relation(fields: [labId], references: [id], onDelete: Cascade)

  name        String
  phone       String
  isAvailable Boolean @default(true)

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orders LabOrder[]

  @@index([labId])
}

model SavedLab {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  labId String?
  lab   LabProfile? @relation(fields: [labId], references: [id], onDelete: Cascade)

  customName    String? // للمختبرات غير المسجلة
  customPhone   String?
  customAddress String?

  isInPlatform Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([clinicId, labId])
  @@index([clinicId])
}

// =======================================
// FINANCE - المالية
// =======================================

model Finance {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  type        String // Revenue, Expense
  category    String // Treatment, Inventory, Lab, Salary, etc.
  amount      Float
  description String? @db.Text

  date      DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([clinicId])
  @@index([type])
  @@index([date])
}

model PatientFinance {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  amount      Float
  type        String // Payment, Charge
  paymentMethod String @default("CASH") // CASH, CARD, INSTALLMENT
  description String?

  // Link to treatment plan
  planId String? // ربط بالخطة العلاجية

  createdAt DateTime @default(now())

  @@index([patientId])
}

// =======================================
// INVENTORY & ASSETS - المخزون والأصول
// =======================================

model InventoryItem {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name        String
  category    String
  quantity    Int
  minQuantity Int    @default(10) // الحد الأدنى للتنبيه

  unit       String? // box, piece, etc.
  expiryDate DateTime?

  cost Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

model Asset {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  name         String
  type         String // Equipment, Device
  serialNumber String?

  purchaseDate DateTime
  warrantyEnds DateTime?

  cost   Float?
  status String @default("Active") // Active, Maintenance, Retired

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
}

// =======================================
// TASKS & REMINDERS - المهام والتذكيرات
// =======================================

model Task {
  id       String @id @default(cuid())
  clinicId String
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  title       String
  description String?    @db.Text
  type        TaskType
  status      TaskStatus @default(PENDING)
  priority    String     @default("Medium") // Low, Medium, High

  createdById String
  createdBy   DentistProfile @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   DentistProfile? @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // معلومات إضافية للعرض
  assignedToName String? // اسم المكلف بالمهمة
  assignedToRole String? // دور المكلف بالمهمة

  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId])
  @@index([assignedToId])
  @@index([status])
}

// =======================================
// MARKETPLACE - المتجر
// =======================================

model Product {
  id       String        @id @default(cuid())
  vendorId String
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  category    String
  brand       String?

  price     Float
  salePrice Float?

  images String[]
  stock  Int      @default(0)

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderItems OrderItem[]

  @@index([vendorId])
  @@index([category])
}

model Order {
  id       String        @id @default(cuid())
  vendorId String
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  buyerId   String // يمكن أن يكون طبيب أو معمل
  buyerType String // Dentist, Lab

  status        String        @default("Pending") // Pending, Processing, Shipped, Delivered
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String        @default("CASH") // CASH only for dental supplies

  subtotal    Float
  platformFee Float
  total       Float

  shippingAddress Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items OrderItem[]

  @@index([vendorId])
  @@index([buyerId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int
  price    Float

  @@index([orderId])
}

// =======================================
// COMMUNITY - المجتمع
// =======================================

model Post {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content     String   @db.Text
  images      String[]
  attachments String[]

  visibility String @default("Public") // Public, Elite, Friends

  likes  Int @default(0)
  shares Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  comments Comment[]

  @@index([authorId])
  @@index([createdAt])
}

model Comment {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  createdAt DateTime @default(now())

  @@index([postId])
}

// =======================================
// JOBS - الوظائف
// =======================================

model Job {
  id       String @id @default(cuid())
  posterId String
  poster   User   @relation(fields: [posterId], references: [id], onDelete: Cascade)

  title       String
  description String    @db.Text
  type        JobType
  status      JobStatus @default(ACTIVE)

  city           String?
  specialization String?

  salary Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([posterId])
  @@index([status])
  @@index([city])
}

// =======================================
// MESSAGING & NOTIFICATIONS
// =======================================

// المحادثات - Conversations
model Conversation {
  id String @id @default(cuid())

  // المشاركون في المحادثة
  participant1Id String
  participant1   User   @relation("ConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)

  participant2Id String
  participant2   User   @relation("ConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)

  // نوع المحادثة
  type MessageType @default(STAFF)

  // معلومات السياق
  clinicId String? // العيادة المرتبطة

  // آخر رسالة
  lastMessageAt DateTime @default(now())
  lastMessage   String?  @db.Text

  // الرسائل
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([clinicId])
  @@index([type])
  @@index([lastMessageAt])
}

// الرسائل - Messages
model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  content String      @db.Text
  type    MessageType @default(STAFF)

  // معلومات السياق
  clinicId     String? // العيادة المرتبطة بالرسالة
  senderRole   String? // دور المرسل
  receiverRole String? // دور المستقبل

  // المرفقات
  attachments Json[] @default([]) // [{name: string, url: string, type: string, size: number}]

  isRead Boolean   @default(false)
  readAt DateTime? // وقت القراءة

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([clinicId])
  @@index([type])
  @@index([createdAt])
  @@index([isRead])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String           @db.Text

  // معلومات السياق
  clinicId   String? // اسم العيادة المرتبطة
  clinicName String? // اسم العيادة
  staffName  String? // اسم الطاقم المرتبط
  staffRole  String? // دور الطاقم

  link String?
  data Json?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([clinicId])
  @@index([type])
}
